module move_select_example (
	input logic vga_clk,
	input logic [3:0] pokemonmove,
	input logic [9:0] DrawX, DrawY,
	input logic blank,
	output logic [3:0] red, green, blue
);
parameter [9:0] move_x = 0;
parameter [9:0] move_y = 301;
parameter [9:0] movesizex = 160;
parameter [9:0] movesizey = 50;


logic [3:0] movecol, moverow;
logic moveseton;
logic [9:0] movesetspritex, movesetspritey; 
logic [9:0] movesetcenterx, movesetcentery;

always_comb begin

movecol = pokemonmove%3;
moverow = pokemonmove/3;


movesetspritex = movecol*movesizex;
movesetspritey = moverow*movesizey;


moveseton = (DrawX >= move_x) && (DrawX < move_x + 639)&&(DrawY >= move_y) && (DrawY < move_y + 178);


if(moveseton) begin
    movesetcenterx = DrawX - move_x;
    movesetcentery = DrawY - move_y;


end


end


logic [16:0] rom_address;

logic [2:0] rom_q;

logic [3:0] palette_red, palette_green, palette_blue;

logic negedge_vga_clk;

// read from ROM on negedge, set pixel on posedge
assign negedge_vga_clk = ~vga_clk;

// address into the rom = (x*xDim)/640 + ((y*yDim)/480) * xDim
// this will stretch out the sprite across the entire screen
assign rom_address = ((movesetspritey+movesetcentery)*640) + (movesetspritex+movesetcenterx);

always_ff @ (posedge vga_clk) begin
	red <= 4'h0;
	green <= 4'h0;
	blue <= 4'h0;

	if (blank) begin
	   if(moveseton)begin
		red <= palette_red;
		green <= palette_green;
		blue <= palette_blue;
		end
	end
end

move_select_rom move_select_rom (
	.clka   (negedge_vga_clk),
	.addra (rom_address),
	.douta       (rom_q)
);

move_select_palette move_select_palette (
	.index (rom_q),
	.red   (palette_red),
	.green (palette_green),
	.blue  (palette_blue)
);

endmodule
